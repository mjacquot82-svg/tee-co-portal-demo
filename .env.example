# Supabase configuration (copy this file to .env and fill values)

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_public_publishable_key_here

# Optional legacy fallback if an older local env still uses the previous name.
# The app will prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# Square payment link creation
# Browser-safe endpoint called by src/services/squareService.js.
VITE_SQUARE_PAYMENT_LINK_ENDPOINT=/.netlify/functions/square-payment-link
# Optional local/demo fallback for unconfigured environments. Keep false in production.
VITE_SQUARE_ALLOW_LOCAL_FALLBACK=false

# Server-side Netlify function secrets. Do not expose these with a VITE_ prefix.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_sandbox_or_production_access_token
SQUARE_LOCATION_ID=your_square_location_id

# Square webhook processing
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
# Use the exact notification URL configured in Square, for example:
# https://your-site.netlify.app/.netlify/functions/square-webhook
SQUARE_WEBHOOK_NOTIFICATION_URL=your_square_webhook_notification_url

# Server-side Supabase key for webhook persistence. Prefer service role in Netlify env only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
