# JDS Platform Supabase configuration (copy this file to .env and fill values)

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_public_publishable_key_here

# Optional legacy fallback if an older local env still uses the previous name.
# The app will prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
VITE_SITE_URL=https://teeandco.jdsstudio.ca

# Notification Engine Phase 2B observation mode.
# Keep false until durable shadow records are explicitly enabled for verification.
# This never changes legacy delivery behavior and does not dispatch Phase 2 deliveries.
VITE_NOTIFICATION_ENGINE_PHASE2B_SHADOW=false

# Phase 2I controlled cutover: legacy (rollback/default), verify, or authoritative.
# Authoritative mode is hard-limited in code to Order Approved email.
VITE_NOTIFICATION_ENGINE_CUTOVER_MODE=legacy
# Server-side gate must also be true before an authoritative Delivery can invoke Resend.
NOTIFICATION_ENGINE_ORDER_APPROVED_CUTOVER=false

# Square payment link creation
# Browser-safe endpoint called by src/services/squareService.js.
VITE_SQUARE_PAYMENT_LINK_ENDPOINT=/.netlify/functions/square-payment-link
# Optional local/demo fallback for unconfigured environments. Keep false in production.
VITE_SQUARE_ALLOW_LOCAL_FALLBACK=false

# Server-side Netlify function secrets. Do not expose these with a VITE_ prefix.
# Tee & Co uses the single-merchant Square Production application.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=your_square_production_access_token
SQUARE_LOCATION_ID=your_square_location_id
# Optional customer return URL after Square Checkout.
SQUARE_CHECKOUT_REDIRECT_URL=https://teeandco.jdsstudio.ca/portal/payments

# Square webhook processing
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
# Use the exact notification URL configured in Square, for example:
# https://teeandco.jdsstudio.ca/.netlify/functions/square-webhook
SQUARE_WEBHOOK_NOTIFICATION_URL=your_square_webhook_notification_url

# Server-side Supabase key for webhook persistence. Prefer service role in Netlify env only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
